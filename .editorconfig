# 🔒 Prevent fallback to parent .editorconfig files
root = true

# 🧠 Apply rules to all C# source files
[*.cs]

##############################
# ✍️ File formatting
##############################

charset = utf-8                            # Ensures UTF-8 encoding — standard and cross-platform safe
end_of_line = crlf                         # Uses Windows line endings (CRLF) — VS default
insert_final_newline = true                # Adds a newline at the end of each file for consistency
trim_trailing_whitespace = true            # Removes stray whitespace to keep diffs clean
indent_style = space                       # Spaces are preferred by Microsoft for consistency
indent_size = 4                            # Standard 4-space indentation for C# code
tab_width = 4                               # Tabs visually align with indentation rules

##############################
# 📁 Namespaces & files
##############################

csharp_style_namespace_declarations = file_scoped:warning   # Microsoft default since .NET 6 — file-scoped namespaces

##############################
# 🧩 Brace layout
##############################

csharp_new_line_before_open_brace = all                     # Always put '{' on a new line — MS standard
csharp_new_line_before_else = true                          # Place 'else' on new line for clarity
csharp_new_line_before_catch = true                         # Consistent layout for exception blocks
csharp_new_line_before_finally = true                       # Improves readability of try/catch/finally
csharp_new_line_between_query_expression_clauses = true     # Aligns complex LINQ expressions vertically

##############################
# 🎛 Indentation rules
##############################

csharp_indent_block_contents = true                         # Indent code blocks normally
csharp_indent_braces = false                                # Braces align with their container
csharp_indent_case_contents = true                          # Indented case bodies — MS standard
csharp_indent_switch_labels = true                          # Switch labels aligned and readable
csharp_indent_labels = flush_left                           # Labels placed at root indentation

##############################
# ➕ Spacing conventions
##############################

csharp_space_after_cast = true                              # Improves readability of cast expressions
csharp_space_after_keywords_in_control_flow_statements = true  # 'if (...)' instead of 'if(...)'
csharp_space_between_method_call_parameter_list_parentheses = false   # No spaces inside parentheses
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_around_binary_operators = before_and_after      # a + b — spacing improves clarity

##############################
# 📚 Using directives
##############################

dotnet_sort_system_directives_first = true                  # Always place 'System.*' first — MS guideline
csharp_using_directive_placement = outside_namespace         # Usings outside namespaces — current MS standard

##############################
# 🏷 Naming rules (Microsoft conventions)
##############################

# 📌 Private fields → _camelCase (Microsoft + current .NET SDK style)
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = camel_with_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.camel_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_with_underscore.required_prefix = _
dotnet_naming_style.camel_with_underscore.word_separator =

# 📌 Public members → PascalCase
dotnet_naming_rule.public_members_pascal.severity = error
dotnet_naming_rule.public_members_pascal.symbols = public_members
dotnet_naming_rule.public_members_pascal.style = pascal_case

dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, protected_internal
dotnet_naming_symbols.public_members.applicable_kinds = method, property, field, event

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.pascal_case.required_prefix =
dotnet_naming_style.pascal_case.word_separator =

# 📌 Interfaces → I-PascalCase
dotnet_naming_rule.interfaces_prefix.severity = error
dotnet_naming_rule.interfaces_prefix.symbols = interface_symbols
dotnet_naming_rule.interfaces_prefix.style = interface_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface

dotnet_naming_style.interface_style.capitalization = pascal_case
dotnet_naming_style.interface_style.required_prefix = I

##############################
# 🧠 var usage rules (Microsoft balanced approach)
##############################

csharp_style_var_for_built_in_types = false:warning         # Prefer explicit types for primitives
csharp_style_var_when_type_is_apparent = true:suggestion    # allow: var x = new Foo()
csharp_style_var_elsewhere = false:warning                  # No var when type is not obvious

##############################
# 🧪 Expression & pattern rules
##############################

csharp_style_prefer_switch_expression = true:suggestion      # Encourage modern switch expressions
csharp_style_expression_bodied_methods = false:silent        # Use expression bodies sparingly
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_prefer_not_pattern = true:suggestion

##############################
# 🔒 Nullability & safety
##############################

dotnet_style_null_propagation = true:warning                # Use ?. for safer access
dotnet_style_coalesce_expression = true:suggestion           # Prefer ?? expressions
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:error

##############################
# 📦 Readonly & immutability
##############################

dotnet_style_readonly_field = true:error                    # Use readonly for fields when possible

##############################
# 🧹 Analyzer rules (Microsoft defaults)
##############################

dotnet_analyzer_diagnostic.severity = warning               # Treat all analyzer diagnostics as warnings

# Enforce async best practices
dotnet_diagnostic.CA2007.severity = warning                 # Do not use ConfigureAwait(false) unnecessarily

# Null checks for public APIs
dotnet_diagnostic.CA1062.severity = error                   # Validate method arguments

# Prefer static members when possible
dotnet_diagnostic.CA1822.severity = warning

# Dead code & simplification hints
dotnet_diagnostic.IDE0001.severity = warning                # Simplify name
dotnet_diagnostic.IDE0044.severity = warning                # Make field readonly

##############################
# 🎨 Visual Studio file types
##############################

[*.{cs,vb}]
tab_width = 4
indent_size = 4
end_of_line = crlf
